# Copy to .env.local and fill in what you have. Every value below is optional
# in development — src/env.ts validates whatever's present, and the modules
# that consume each one (src/server/*) degrade to a logged, non-fatal
# fallback when it's absent (console-only lead capture, skipped Turnstile
# check, in-memory rate limit). See src/env.ts for the full explanation.

# --- Lead store (F34 — not yet built) ---------------------------------------
# Serverless Postgres connection string (Neon or Vercel Postgres).
DATABASE_URL=

# --- Transactional email (F32) ----------------------------------------------
# https://resend.com — API key, plus the verified from/to addresses.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# --- Abuse protection (F33) -------------------------------------------------
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# https://upstash.com — REST API credentials for the Redis rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability (F41) ----------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Analytics (F35) ---------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
